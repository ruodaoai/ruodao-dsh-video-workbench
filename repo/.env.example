# ============================================================================
# DSH Video Workbench - Environment Configuration Template (.env.example)
# Copy this file to `.env` and fill in your local machine paths.
# DO NOT commit `.env` to Git.
# ============================================================================

# --- 1. DeepSeek Harness (DSH) Runtime Paths ---
# Path to DeepSeek Harness Desktop `app` directory (optional if `dsh` is on PATH)
DSH_APP_ROOT=
# Optional custom DSH_HOME directory for isolated profile state
DSH_VIDEO_HOME=
# Default workspace root where video projects are stored
DSH_VIDEO_WORKSPACE=./examples

# --- 2. FFmpeg & Media Probing ---
# Path to ffmpeg and ffprobe executables (falls back to system PATH if empty)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- 3. Local TTS Engines (IndexTTS-2.5 & GPTvoice-tts / GPT-SoVITS) ---
# Preferred engine: indextts25 | indextts2 | gptvoice | auto
DEFAULT_TTS_ENGINE=indextts25

# IndexTTS-2.5 (recommended, https://github.com/index-tts/index-tts) or legacy IndexTTS-2 HTTP Endpoint & Local Root
INDEXTTS_ENDPOINT=http://127.0.0.1:9880
INDEXTTS_WEBUI_ENDPOINT=http://127.0.0.1:7860
INDEXTTS_ROOT=
INDEXTTS_PYTHON=
INDEXTTS_QWEN_EMO=1

# GPTvoice-tts (GPT-SoVITS) HTTP Endpoint & Local Installation Root
GPTVOICE_ENDPOINT=http://127.0.0.1:9881
GPTVOICE_ROOT=
GPTVOICE_PYTHON=
GPTVOICE_SHARED_PYLIBS=
GPTVOICE_CONFIG=GPT_SoVITS/configs/tts_infer.yaml

# --- 4. Voice Pack Catalog & Default Reference Audio ---
# Directory storing voice pack catalog and imported voice packs
VOICE_PACKS_DIR=./voice-packs
# Optional extra directories to scan for existing voice references (semicolon-separated on Windows)
EXTRA_VOICE_SCAN_DIRS=
# Optional default fallback reference WAV and prompt text
DEFAULT_REF_AUDIO=
DEFAULT_REF_TEXT=

# --- 5. Dual-Engine Video Rendering (HTML/GSAP & Remotion) ---
# Existing local Remotion project directory providing @remotion/bundler & @remotion/renderer
REMOTION_TEMPLATE_ROOT=
# Playwright Chromium browsers cache directory (for HTML frame-accurate snapshot & render)
PLAYWRIGHT_BROWSERS_PATH=
# Optional path to Chromium / Chrome / Edge binary for HTML snapshot & rendering
BROWSER_EXECUTABLE_PATH=
# Optional SuperCollider (Vibecoding tool #6) for AI-coded music: path to sclang(.exe). Leave empty to auto-detect
# installer builds and portable zips (Program Files, %LOCALAPPDATA%\Programs, <drive>:\video_tools, <drive>:\tools).
SCLANG_PATH=
# AI-coded music engine: auto (SuperCollider when installed, else built-in JS DSP) | supercollider | js
DSH_AUDIO_ENGINE=auto

# Resumable chunked Remotion rendering: frame-exact chunk length in seconds (default 10; 0 = legacy single pass)
DSH_RENDER_CHUNK_SEC=10
# Keep finished chunks in output/.chunks so unchanged re-renders only re-mux audio (0 = delete after a successful render)
DSH_RENDER_CHUNK_KEEP=1
# Post-render temporal QA (photosensitive flash risk / frozen frames / jump cuts): 1 = on (default), 0 = off
DSH_QA_TEMPORAL=1
# Report frozen frames longer than this many seconds that the shot list does not plan as static holds
DSH_QA_FREEZE_SEC=2.5

# --- 6. Model-Agnostic LLM Coding Studio ---
# Mode: follow-dsh (default: follows active DSH client provider/model/key) | custom (explicit plugin fields)
# Wire protocols supported: auto | openai-completions | anthropic-messages | openai-responses | gemini-native
LLM_MODE=follow-dsh
LLM_PROVIDER=
LLM_FORMAT=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_REPAIR_ROUNDS=3

# --- 6b. Project safety: free stock media, paid cloud-job cap, version history ---
# Free royalty-free stock via the OFFICIAL APIs only (both keys are free at pexels.com/api and pixabay.com/api/docs).
# Easier: fill them in the studio (版本历史与工程安全 → 免费素材, or 设置 → 云端生成); keys saved there take precedence.
# Without keys the stock search reports "未配置"; auto B-roll then never uses stock.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Max NEW paid cloud generations (image/video/music) a single pipeline run may submit automatically for B-roll.
# 0 (default) = automatic paid generation off. Ledger reuse / resume of already-paid jobs never counts.
DSH_CLOUD_MAX_PAID_JOBS_PER_RUN=0
# Project version history retention (versions kept per project; unreferenced snapshot objects are garbage-collected)
DSH_HISTORY_MAX=50

# --- 7. Pluggable AI & Cloned Digital Human Avatar (`dsh-tool-avatar`) ---
# Provider: auto | musetalk | latentsync | external-http | local-composite
AVATAR_PROVIDER=auto
# Local MuseTalk / LatentSync Gradio or REST server, or remote API URL (optional)
AVATAR_ENDPOINT=
# Optional Bearer API key for external digital human provider (never commit secrets)
AVATAR_API_KEY=
AVATAR_TIMEOUT_MS=180000

# --- 7b. Talking-head lip-sync engine for cloned-human avatars (`dsh-tool-avatar/lipsync-engine.js`) ---
# Install the local engine: node scripts/install-lipsync-engine.mjs --engine musetalk --dir D:/dsh-ai/lipsync --mirror cn
# (writes AVATAR_LIPSYNC_ENGINE / _HOME / _PYTHON below automatically; status: GET /api/video-workbench/avatar/lipsync?deep=1)
# Engine: auto (musetalk if installed, else cloud-fal if a key is set, else off)
#       | musetalk (local MuseTalk 1.5, MIT code; NVIDIA GPU, ~4 GB VRAM peak with fp16)
#       | latentsync (official ByteDance LatentSync repo you installed yourself, run through its CLI)
#       | cli (any command template, see AVATAR_LIPSYNC_CLI_*) | cloud-fal (fal.ai BYOK) | off
AVATAR_LIPSYNC_ENGINE=auto
# Install home created by the installer: MuseTalk/ (code + models), .venv/, torch-hub/, eval/, lipsync-engine.json
AVATAR_LIPSYNC_HOME=
# Python of the lip-sync venv (default <home>/.venv/Scripts/python.exe); MuseTalk repo dir (default <home>/MuseTalk)
AVATAR_LIPSYNC_PYTHON=
AVATAR_LIPSYNC_MUSETALK_DIR=
# face-alignment (S3FD + FAN) weights dir (default <home>/torch-hub)
AVATAR_LIPSYNC_TORCH_HOME=
# What to do when the engine is missing or fails: composite (default: keep the old non-lip-sync overlay) | error
AVATAR_LIPSYNC_FALLBACK=composite
# Inference tuning: cuda | cpu, fp16 on/off, UNet batch, model fps (MuseTalk is trained at 25 fps)
AVATAR_LIPSYNC_DEVICE=cuda
AVATAR_LIPSYNC_FP16=1
AVATAR_LIPSYNC_BATCH_SIZE=16
AVATAR_LIPSYNC_FPS=25
# Longest side of processed frames, and max seconds of the recording used as the base loop (frames are held in RAM)
AVATAR_LIPSYNC_MAX_SIDE=1280
AVATAR_LIPSYNC_MAX_SOURCE_SEC=8
# MuseTalk 1.5 blending: chin margin (px), face-parsing mode (jaw | neck | raw), cheek width, bbox temporal smoothing (frames)
AVATAR_LIPSYNC_EXTRA_MARGIN=10
AVATAR_LIPSYNC_PARSING_MODE=jaw
AVATAR_LIPSYNC_CHEEK_WIDTH=90
AVATAR_LIPSYNC_BBOX_SMOOTH=5
# Subprocess timeout in seconds (0 = auto: 150 s + 14 s per second of narration)
AVATAR_LIPSYNC_TIMEOUT_SEC=0
# VRAM guard: when free VRAM is below this many MB, pause the local IndexTTS server during lip-sync and restart it
# afterwards (auto) | always pause it | never touch it
AVATAR_LIPSYNC_MIN_FREE_VRAM_MB=4500
AVATAR_LIPSYNC_FREE_TTS_VRAM=auto
# LatentSync preset (engine=latentsync): repo dir and its Python (default <dir>/.venv); args override via AVATAR_LIPSYNC_CLI_ARGS
AVATAR_LIPSYNC_LATENTSYNC_DIR=
AVATAR_LIPSYNC_LATENTSYNC_PYTHON=
# Generic CLI engine (engine=cli): executable, argument template with {video} {audio} {output} {fps}, working dir
AVATAR_LIPSYNC_CLI_COMMAND=
AVATAR_LIPSYNC_CLI_ARGS=
AVATAR_LIPSYNC_CLI_CWD=
# Cloud fallback (engine=cloud-fal): fal.ai queue API. Model: fal-ai/latentsync (default) | fal-ai/sync-lipsync/v2
#   | fal-ai/kling-video/lipsync/audio-to-video ... Key: AVATAR_LIPSYNC_CLOUD_API_KEY or FAL_KEY (never commit secrets)
AVATAR_LIPSYNC_CLOUD_ENDPOINT=https://queue.fal.run
AVATAR_LIPSYNC_CLOUD_MODEL=fal-ai/latentsync
AVATAR_LIPSYNC_CLOUD_API_KEY=
AVATAR_LIPSYNC_CLOUD_TIMEOUT_SEC=900
# Optional extra JSON merged into the fal input, e.g. {"sync_mode":"cut_off"}
AVATAR_LIPSYNC_CLOUD_INPUT_JSON=


