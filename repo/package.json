  },
  "exports": {
    ".": "./index.js",
    "./mcp": "./bin/dsh-video-mcp.mjs",
    "./cli": "./bin/dsh-video-cli.mjs",
    "./client": "./packages/dsh-web-video-workbench/lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "bin",
    "packages/shared",
    "packages/dsh-tool-local-tts",
    "packages/dsh-tool-avatar",
    "packages/dsh-tool-video-suite",
    "packages/dsh-tool-media",
    "packages/dsh-preset-video",
    "packages/dsh-web-video-workbench",
    "scripts/dsh-runner.mjs",
    "scripts/install-profile.mjs",
    "scripts/install-tts-engine.mjs",
    "scripts/install-tts-engine.ps1",
    "scripts/tts-bridge.py",
    "scripts/tts-server.py",
    "start-workbench.vbs",
    "start-workbench.cmd",
    "stop-workbench.cmd",
    "templates/cinepulse-hub",
    "voice-packs/README.md",
    "voice-packs/catalog.example.json",
    ".mcp.json",
    ".claude-plugin",
    "SKILL.md",
    "AGENTS.md",
    "docs/install.md",
    "docs/plaza-community.md",
    ".env.example",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "studio": "node ./bin/dsh-video-cli.mjs studio --open",
    "mcp": "node ./bin/dsh-video-mcp.mjs",
    "doctor": "node ./bin/dsh-video-cli.mjs doctor",
    "install:tts": "node ./scripts/install-tts-engine.mjs",
    "dsh": "node ./scripts/dsh-runner.mjs",
    "dsh:video": "node ./scripts/dsh-runner.mjs video",
    "setup:profile": "node ./scripts/install-profile.mjs",
    "pack:bundle": "node ./scripts/pack-bundle.mjs",
    "test": "node ./scripts/self-test.mjs"
  },
  "dependencies": {
